# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# Option A: Local Docker PostgreSQL (Default)
POSTGRES_USER=evallens
POSTGRES_PASSWORD=evallens_secret
POSTGRES_DB=evallens
DATABASE_URL=postgresql+asyncpg://evallens:evallens_secret@localhost:5432/evallens

# Option B: Supabase Cloud PostgreSQL (with pgvector)
# Replace [project-ref], [db-password], and [region] from your Supabase Project Settings -> Database -> Connection String
# Session Pooler (port 5432 - Recommended for asyncpg / SQLAlchemy):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or Transaction Pooler (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Direct:
# DATABASE_URL=postgresql+asyncpg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres

# LLM & Embedding Providers (Optional in Demo Mode)
OPENAI_API_KEY=sk-...
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_JUDGE_MODEL=gpt-4o-mini

# App Settings
MAX_CONCURRENT_EVALS=5
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
